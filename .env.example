PORT=3000
EXCEPTIONOS_DB=./data/local.sqlite
ADMIN_EMAIL=admin@example.com
# Optional: OpenAI-compatible JSON chat-completions endpoint.
# Never put credentials in browser code. AI requests transmit case content to your configured provider.
AI_API_URL=
AI_API_KEY=
AI_MODEL=
# Exact additional browser origins allowed to use the authenticated API.
# For the local Anna harness: http://localhost:5180 (set by npm run start:anna).
EXCEPTIONOS_ALLOWED_ORIGINS=
# Build-time only: backend origin embedded by npm run anna:build.
EXCEPTIONOS_API_ORIGIN=http://localhost:3001
